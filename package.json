{
  "name": "preflight",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "format": "prettier --write \"{client,server}/src/**/*.{ts,vue,css}\" \"*.js\" client/vite.config.ts",
    "format:check": "prettier --check \"{client,server}/src/**/*.{ts,vue,css}\" \"*.js\" client/vite.config.ts",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
