{
  "name": "preflight",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "format": "prettier --write \"{client,server,shared}/src/**/*.{ts,vue,css}\" \"e2e/**/*.ts\" \"*.js\" client/vite.config.ts",
    "format:check": "prettier --check \"{client,server,shared}/src/**/*.{ts,vue,css}\" \"e2e/**/*.ts\" \"*.js\" client/vite.config.ts",
    "lint": "eslint .",
    "knip": "knip",
    "check": "npm run format:check && npm run lint && npm run knip && npm run typecheck -w shared && npm run typecheck -w server && tsc --noEmit -p e2e && npm test -w shared && npm test -w server && npm test -w client && npm run build -w client",
    "test:e2e": "playwright test -c e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
